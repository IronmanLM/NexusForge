{
  "name": "nexus-forge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "npm run typecheck",
    "build": "npm run typecheck && vite build",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:sync": "npx cap sync",
    "mobile:copy": "npx cap copy",
    "mobile:android": "npx cap open android",
    "mobile:android:doctor": "bash ./scripts/mobile-android-doctor.sh",
    "mobile:android:apk": "bash ./scripts/mobile-android-build-apk.sh debug",
    "mobile:android:apk:release": "bash ./scripts/mobile-android-build-apk.sh release",
    "mobile:android:aab:release": "bash ./scripts/mobile-android-build-apk.sh bundle",
    "test": "npm run test:run",
    "test:run": "node -e \"console.log('No tests configured yet')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "dexie": "^4.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
