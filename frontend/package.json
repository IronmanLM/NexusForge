{
  "name": "nexus-forge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,md,json}\"",
    "build": "npm run typecheck && vite build",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:sync": "npx cap sync",
    "mobile:copy": "npx cap copy",
    "mobile:android": "npx cap open android",
    "mobile:android:doctor": "bash ./scripts/mobile-android-doctor.sh",
    "mobile:android:apk": "bash ./scripts/mobile-android-build-apk.sh debug",
    "mobile:android:apk:release": "bash ./scripts/mobile-android-build-apk.sh release",
    "mobile:android:aab:release": "bash ./scripts/mobile-android-build-apk.sh bundle",
    "test": "npm run test:run",
    "test:run": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "dexie": "^4.3.0",
    "pixi.js": "^8.21.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
