DISCORD_BOT_TOKEN=
DISCORD_BOT_SHARED_SECRET=
DISCORD_DASHBOARD_SESSION_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://bot.nexusforge.en-ligne.fr/auth/discord/callback
NEXUSFORGE_API_BASE_URL=https://api.nexusforge.en-ligne.fr
NEXUSFORGE_APP_BASE_URL=https://nexusforge.en-ligne.fr
DISCORD_OWNER_USER_IDS=

# Canaux de diffusion produit
DISCORD_NEWS_CHANNEL_IDS=123456789012345678,234567890123456789

# Canaux et/ou utilisateurs staff pour les alertes admin
DISCORD_STAFF_CHANNEL_IDS=345678901234567890
DISCORD_STAFF_USER_IDS=

# Strategie au premier demarrage:
# - latest: se positionne sur le dernier evenement sans reenvoi historique
# - replay: rejoue les evenements recuperes tant qu aucun curseur n existe
DISCORD_BOT_BOOTSTRAP_MODE=latest

# Delai entre deux synchronisations backend (ms)
DISCORD_BOT_POLL_INTERVAL_MS=15000

# Fichier de persistance local du curseur de lecture
DISCORD_BOT_STATE_FILE=./data/state.json
DISCORD_BOT_DASHBOARD_STATE_FILE=./data/dashboard-state.json
